# Qwen3.8-27B, community GPTQ int4 (~17-19 GB weights).
# For 24-32 GB cards and for Ampere (RTX A6000, RTX 3090), where FP8 is slow.
# Slightly lower quality than the official FP8 build.
HF_REPO="palmfuture/Qwen3.8-27B-GPTQ-Int4"
MODEL_DIR="qwen3.8-27b-gptq-int4"
SERVED_MODEL_NAME="qwen3.8-27b"
VLLM_TAG="v0.25.1"            # tested by the quantizer on vLLM 0.25.1
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.92
MAX_NUM_SEQS=4
EXTRA_VLLM_ARGS="--quantization gptq --dtype float16 --reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder --language-model-only"
