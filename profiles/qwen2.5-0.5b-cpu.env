# Qwen2.5-0.5B Instruct — minimal CPU-only profile for infrastructure testing.
# 0.5 B params, ~1 GB weights (BF16). No GPU required. Fits in 16 GB system RAM.
# Inference is slow on CPU; use this profile to validate the stack, not for production.
# No MODEL_RUNTIME / NVIDIA_VISIBLE_DEVICES → Docker uses the default runc runtime.
HF_REPO="Qwen/Qwen2.5-0.5B-Instruct"
MODEL_DIR="qwen2.5-0.5b-instruct"
SERVED_MODEL_NAME="qwen2.5-0.5b"
VLLM_TAG="v0.25.1"
MAX_MODEL_LEN=4096
GPU_MEMORY_UTILIZATION=0.90   # ignored by vLLM when --device cpu is set
MAX_NUM_SEQS=2
EXTRA_VLLM_ARGS="--device cpu --enforce-eager"
