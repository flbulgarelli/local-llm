# Olmo 3 7B Instruct (AI2, Apache 2.0), official BF16 checkpoint quantized to
# 4-bit at load time by vLLM (bitsandbytes). ~5 GB of weights on the GPU.
# Target: 8 GB cards such as the RTX 4060. Context and concurrency are tight.
# Loading needs ~16 GB system RAM (the BF16 file is read before quantizing).
# Swap the repo to allenai/Olmo-3-7B-Think for the reasoning variant.
# Not suitable for code assistance; use a Qwen profile for that.
MODEL_RUNTIME=nvidia
NVIDIA_VISIBLE_DEVICES=all
HF_REPO="allenai/Olmo-3-7B-Instruct"
MODEL_DIR="olmo3-7b-instruct"
SERVED_MODEL_NAME="olmo3-7b"
VLLM_TAG="v0.25.1"
MAX_MODEL_LEN=8192
GPU_MEMORY_UTILIZATION=0.85   # leave room for the desktop/display on consumer cards
MAX_NUM_SEQS=2
# --enforce-eager skips CUDA graph capture, saving ~0.5-1 GB on small cards (a bit slower).
EXTRA_VLLM_ARGS="--quantization bitsandbytes --kv-cache-dtype fp8 --enforce-eager"
