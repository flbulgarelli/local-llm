# Olmo 3 7B Instruct, official BF16 checkpoint quantized to FP8 at load time
# (~7.5 GB weights). Target: 16-24 GB Ada/Blackwell cards (RTX 4060 Ti 16GB,
# RTX 4000 Ada 20GB). Same download folder as the 8 GB profile.
# Not suitable for code assistance; use a Qwen profile for that.
MODEL_RUNTIME=nvidia
NVIDIA_VISIBLE_DEVICES=all
HF_REPO="allenai/Olmo-3-7B-Instruct"
MODEL_DIR="olmo3-7b-instruct"
SERVED_MODEL_NAME="olmo3-7b"
VLLM_TAG="v0.25.1"
MAX_MODEL_LEN=32768
MODEL_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=4
EXTRA_VLLM_ARGS="--quantization fp8 --kv-cache-dtype fp8 --hf-overrides {\"rope_parameters\":{\"rope_type\":\"default\",\"rope_theta\":500000}}"
