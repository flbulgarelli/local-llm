# SmolLM2-135M Instruct — perfil CPU-only mínimo para pruebas de infraestructura.
# 135M params, ~270 MB pesos (BF16). Sin GPU. Arquitectura LlamaForCausalLM.
# No apto para uso general; solo para validar el stack.
# No MODEL_RUNTIME / NVIDIA_VISIBLE_DEVICES → Docker usa el runtime runc por defecto.
HF_REPO="HuggingFaceTB/SmolLM2-135M-Instruct"
MODEL_DIR="smollm2-135m-instruct"
SERVED_MODEL_NAME="smollm2-135m"
VLLM_TAG="v0.25.1"
MAX_MODEL_LEN=8192
# Proporción de RAM del sistema disponible para el modelo (semántica CPU: no es VRAM)
MODEL_MEMORY_UTILIZATION=0.3
MAX_NUM_SEQS=2
EXTRA_VLLM_ARGS="--enforce-eager --enable-auto-tool-choice --tool-call-parser hermes"
