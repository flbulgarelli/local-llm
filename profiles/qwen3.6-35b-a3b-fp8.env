# Qwen3.6-35B-A3B (MoE, 3B active) in FP8 (~35 GB weights). Much faster
# generation than the 27B dense model, less KV headroom on 48 GB.
# NOTE: verify the exact repo name on huggingface.co/Qwen before downloading.
MODEL_RUNTIME=nvidia
NVIDIA_VISIBLE_DEVICES=all
HF_REPO="Qwen/Qwen3.6-35B-A3B-FP8"
MODEL_DIR="qwen3.6-35b-a3b-fp8"
SERVED_MODEL_NAME="qwen3.6-35b-a3b"
VLLM_TAG="v0.25.1"
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.94
MAX_NUM_SEQS=4
EXTRA_VLLM_ARGS="--reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder --language-model-only"
