# Qwen3.8-27B in NVFP4 (~25 GB weights). ONLY for Blackwell GPUs
# (e.g. RTX Pro 5000 48GB). Leaves the most room for KV cache / long context.
MODEL_RUNTIME=nvidia
NVIDIA_VISIBLE_DEVICES=all
HF_REPO="Inferact/Qwen3.8-27B-NVFP4"
MODEL_DIR="qwen3.8-27b-nvfp4"
SERVED_MODEL_NAME="qwen3.8-27b"
VLLM_TAG="v0.25.1"
MAX_MODEL_LEN=131072
GPU_MEMORY_UTILIZATION=0.92
MAX_NUM_SEQS=8
EXTRA_VLLM_ARGS="--kv-cache-dtype fp8 --reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder --language-model-only"
