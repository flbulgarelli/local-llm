# Qwen3.8-27B, official FP8 checkpoint (~26-28 GB weights). Recommended default for 48 GB.
# Best choice on Ada (L40S, RTX 6000 Ada) or Hopper. Also runs on Ampere
# via weight-only FP8 kernels, but slower; prefer qwen3.8-27b-gptq-int4 there.
MODEL_RUNTIME=nvidia
NVIDIA_VISIBLE_DEVICES=all
HF_REPO="Qwen/Qwen3.8-27B-FP8"
MODEL_DIR="qwen3.8-27b-fp8"
SERVED_MODEL_NAME="qwen3.8-27b"
VLLM_TAG="v0.25.1"            # Qwen3.8 needs vLLM >= 0.17.0
MAX_MODEL_LEN=65536
GPU_MEMORY_UTILIZATION=0.92
MAX_NUM_SEQS=8
# --language-model-only skips the vision tower (text/code focus, saves memory).
# On Ada/Hopper/Blackwell you can add: --kv-cache-dtype fp8  (roughly doubles context capacity)
EXTRA_VLLM_ARGS="--reasoning-parser qwen3 --enable-auto-tool-choice --tool-call-parser qwen3_coder --language-model-only"
