# Shared settings, independent of the selected model.
VLLM_API_KEY="change-me-local-api-key"
WEBUI_SECRET_KEY="change-me-to-a-long-random-string"
WEBUI_PORT=3000

# Descomentar para exponer al exterior
# VLLM_BIND=0.0.0.0
VLLM_BIND=127.0.0.1

# Pin this to a specific release tag (e.g. the one you pulled) for reproducibility.
OPENWEBUI_TAG=main

# Cantidad de GPUs a usar para el modelo. Dejar en 1 o
# comentado para una sola GPU. Dependiendo del modelo y los attention headers del modelo,
# si la división no es exacta, algunos valores podrían no funcionar.
# TENSOR_PARALLEL_SIZE=1
